# Copy this file to .env (cp .env.example .env) and fill in your key.
# SkyLLM auto-loads .env at startup; values here never override real shell exports.

# Required: a Groq API key (used by the LLM planner).
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default Groq model.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: only needed if the vision service runs on a different machine.
# EDGE_SERVICE_IP=localhost
# EDGE_SERVICE_PORT=50049
